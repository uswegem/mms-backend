# Copy to .env

# --- PostgreSQL (Prisma) ---
# Runtime: transaction pooler (6543) — add ?pgbouncer=true for Supabase
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations/DDL: session pooler (5432) — required for prisma db push / migrate
DIRECT_DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Supabase (optional) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- JWT (change in production — min 32 chars) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Auth ---
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_REFRESH_COOKIE_NAME=refreshToken
AUTH_PASSWORD_RESET_HOURS=1
BCRYPT_ROUNDS=12
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MFA_ISSUER=MMS

# --- Swagger ---
SWAGGER_ENABLED=true
SWAGGER_TITLE=MMS API
SWAGGER_DESCRIPTION=Merchant Management System API
SWAGGER_VERSION=1.0

# --- Audit ---
AUDIT_ENABLED=true

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# --- RabbitMQ ---
RABBITMQ_URL=amqp://mms:mms@localhost:5672
RABBITMQ_ENABLED=true
RABBITMQ_EXCHANGE=mms.events
