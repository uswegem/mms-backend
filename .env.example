# Copy to .env

# --- PostgreSQL (Prisma) ---
# Runtime: transaction pooler (6543) — add ?pgbouncer=true for Supabase
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations/DDL: session pooler (5432) — required for prisma db push / migrate
DIRECT_DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Supabase (optional) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- JWT (change in production — min 32 chars) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Auth ---
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_REFRESH_COOKIE_NAME=refreshToken
AUTH_PASSWORD_RESET_HOURS=1
BCRYPT_ROUNDS=12

# --- Rate limiting (Redis-backed via @nestjs/throttler) ---
# Default applies to all routes; auth endpoints (login, forgot-password,
# mfa/verify) use the tighter AUTH limit via an explicit @Throttle() override.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=5

# --- Argon2id password migration ---
# Floor per OWASP's primary recommendation; raise ARGON2_MEMORY_COST_KIB if
# the production instance's CPU/memory budget allows (unconfirmed — see
# docs/architecture-decisions).
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Comma-separated Role.code values forced onto immediate reset at cutover,
# in addition to anyone holding a permission ending in ":approve".
AUTH_PRIVILEGED_ROLE_CODES=SUPER_ADMIN,BANK_ADMIN
# Set to the actual production deploy date when this ships — the 90-day
# backstop clock starts here for every account.
ARGON2_MIGRATION_START_DATE=2026-08-16
ARGON2_BACKSTOP_DAYS=90
ARGON2_BACKSTOP_WARNING_DAYS=7

# --- RS256 JWT signing via Vault Transit (never a raw key in this app) ---
# Dev-mode Vault (docker-compose) — fixed root token, fine for local/CI only.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=mms-dev-root-token
# Production path instead of VAULT_TOKEN — provisioned by `npm run vault:setup`.
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
VAULT_JWT_KEY_NAME=mms-jwt-signing
VAULT_QR_KEY_NAME=mms-qr-signing
JWT_PUBLIC_KEY_CACHE_TTL_MS=3600000

# --- Payments / settlement (mock TIPS + CBS adapters) ---
TIPS_WEBHOOK_SECRET=
PAYMENT_TIMEOUT_MINUTES=10
SETTLEMENT_DEFAULT_MDR_RATE=0.0085
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MFA_ISSUER=MMS

# --- Swagger ---
SWAGGER_ENABLED=true
SWAGGER_TITLE=MMS API
SWAGGER_DESCRIPTION=Merchant Management System API
SWAGGER_VERSION=1.0

# --- Audit ---
AUDIT_ENABLED=true

# --- Email (SMTP) ---
# Set MAIL_ENABLED=true and configure SMTP to email temporary passwords on user creation.
# Example: Mailtrap (https://mailtrap.io) for local testing.
MAIL_ENABLED=false
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username
MAIL_PASS=your-smtp-password
MAIL_FROM=MMS <noreply@mms.local>

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# --- RabbitMQ ---
RABBITMQ_URL=amqp://mms:mms@localhost:5672
RABBITMQ_ENABLED=true
RABBITMQ_EXCHANGE=mms.events
