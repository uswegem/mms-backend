model GlobalAliasSequence {
  id      String @id @default("GLOBAL")
  lastSeq Int    @default(0) @map("last_seq")

  @@map("global_alias_sequences")
}

/// Flat global sequence for 10-digit student aliases ([780][seq6][check1]).
/// A single GLOBAL row; the atomic UPDATE caps at 999,999.
model StudentAliasSequence {
  id      String @id @db.VarChar(6)
  lastSeq Int    @default(0) @map("last_seq")

  @@map("student_alias_sequences")
}

/// Per-block sequence for the 8-digit Lipa Namba alias (AAA-CCCC-S). One row
/// per allocated 3-digit acquirer block (780/781/782); allocation tries blocks
/// in order and rolls over once a block's 4-digit space (0000-9999) is used up.
model AliasBlockSequence {
  block   String @id @db.Char(3)
  lastSeq Int    @default(0) @map("last_seq")

  @@map("alias_block_sequences")
}

/// Sequence for TANQR tag 26/02 Merchant ID (up to 15 digits) — distinct from
/// the 8-digit Lipa Namba alias (tag 62/03). Assigned once per merchant via
/// TipsRegistration.merchantId15 and never reassigned.
model TipsMerchantIdSequence {
  id      String @id @default("GLOBAL")
  lastSeq Int    @default(0) @map("last_seq")

  @@map("tips_merchant_id_sequences")
}

model MerchantAlias {
