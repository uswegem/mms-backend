  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("tips_registrations")
}

model QrCode {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String    @map("merchant_id") @db.Uuid
  studentId       String?   @map("student_id") @db.Uuid
  storeId         String?   @map("store_id") @db.Uuid
  terminalId      String?   @map("terminal_id") @db.Uuid
  qrType          QrType    @map("qr_type")
  status          QrStatus  @default(ACTIVE)
  poiMethod       String    @map("poi_method") @db.Char(2)
  currentVersion  Int       @default(1) @map("current_version")
  /// True when the latest regeneration changed the fixed amount (tag 54)
  /// baked into a static QR — any previously printed sticker now encodes a
  /// stale amount and needs reprinting. Cleared via the acknowledge-reprint
  /// action once ops confirms the new sticker is in place.
  reprintRequired Boolean   @default(false) @map("reprint_required")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid

  merchant        Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  student         Student?           @relation(fields: [studentId], references: [id])
  payloadVersions QrPayloadVersion[]
  renderAssets    QrRenderAsset[]
  studentAliases  StudentAlias[]

  @@index([merchantId, status])
  @@index([merchantId, qrType, status, storeId, terminalId])
  @@map("qr_codes")
}

model QrPayloadVersion {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  qrId               String   @map("qr_id") @db.Uuid
  version            Int
  tlvPayload         String   @map("tlv_payload") @db.Text
  crcValue           String   @map("crc_value") @db.Char(4)
  tag26MerchantId    String?  @map("tag_26_02_merchant_id") @db.VarChar(15)
  tag62StoreLabel    String?  @map("tag_62_03_store_label") @db.VarChar(25)
  tag62InternalId    String?  @map("tag_62_05_internal_id") @db.VarChar(25)
  tag62TerminalLabel String?  @map("tag_62_07_terminal_label") @db.VarChar(25)
  amount             Decimal? @db.Decimal(18, 2)
  billNumber         String?  @map("bill_number") @db.VarChar(25)
  referenceLabel     String?  @map("reference_label") @db.VarChar(25)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  qrCode       QrCode          @relation(fields: [qrId], references: [id], onDelete: Cascade)
  renderAssets QrRenderAsset[]

  @@unique([qrId, version])
  // Ties a dynamic QR payload to a stable, per-merchant-unique identifier
  // (tag 62/01) so a scan can be matched back to the exact version it came
  // from, instead of only "the latest active QR for this merchant" — a
  // stale/replayed dynamic QR image must not resolve to a newer version.
  // NULLs (static QRs, which don't carry a bill number) are unconstrained.
  @@unique([tag26MerchantId, billNumber], map: "qr_payload_versions_merchant_billnumber_key")
  @@map("qr_payload_versions")
}

/// Per-merchant atomic counter used to auto-generate a guaranteed-unique
/// Bill Number (tag 62/01) for dynamic QRs that don't specify their own.
model DynamicQrSequence {
  merchantId String @id @map("merchant_id") @db.Uuid
  lastSeq    Int    @default(0) @map("last_seq")

  @@map("dynamic_qr_sequences")
}

model QrRenderAsset {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  qrId             String   @map("qr_id") @db.Uuid
  payloadVersionId String?  @map("payload_version_id") @db.Uuid
  format           String   @db.VarChar(10)
  s3Bucket         String   @map("s3_bucket") @db.VarChar(100)
  s3Key            String   @map("s3_key") @db.VarChar(500)
  fileHash         String?  @map("file_hash") @db.VarChar(64)
  width            Int?
  height           Int?
  sizeBytes        BigInt?  @map("size_bytes")
  templateId       String?  @map("template_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  qrCode         QrCode            @relation(fields: [qrId], references: [id], onDelete: Cascade)
  payloadVersion QrPayloadVersion? @relation(fields: [payloadVersionId], references: [id], onDelete: SetNull)

  @@index([qrId])
  @@map("qr_render_assets")
}

model Payment {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acquirerId        String         @map("acquirer_id") @db.Uuid
  merchantId        String         @map("merchant_id") @db.Uuid
  storeId           String?        @map("store_id") @db.Uuid
  terminalId        String?        @map("terminal_id") @db.Uuid
  tipsEndToEndId    String         @unique @map("tips_end_to_end_id") @db.VarChar(100)
  amount            Decimal        @db.Decimal(18, 2)
  currency          String         @default("TZS") @db.Char(3)
  status            PaymentStatus
  channel           PaymentChannel
  payerMsisdnMasked String?        @map("payer_msisdn_masked") @db.VarChar(20)
  payerNameMasked   String?        @map("payer_name_masked") @db.VarChar(100)
  payerFsp          String?        @map("payer_fsp") @db.VarChar(50)
  tipsSettledAt     DateTime?      @map("tips_settled_at") @db.Timestamptz(6)
  receivedAt        DateTime       @default(now()) @map("received_at") @db.Timestamptz(6)
  settlementCycleId String?        @map("settlement_cycle_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  acquirer        Acquirer         @relation(fields: [acquirerId], references: [id])
  merchant        Merchant         @relation(fields: [merchantId], references: [id])
  settlementCycle SettlementCycle? @relation(fields: [settlementCycleId], references: [id])
  disputes        Dispute[]

  @@index([merchantId, status])
  @@index([merchantId, receivedAt])
  @@index([settlementCycleId])
  @@map("payments")
}

/// One row per merchant per settlement run — the sweep job (T+0/T+1) groups
/// that day's SUCCESS payments not yet in a cycle, computes gross/MDR/net
/// off MerchantSettlementConfig.mdr, then a mock CBS posting closes it out.
model SettlementCycle {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId          String                @map("merchant_id") @db.Uuid
  cycleDate           DateTime              @map("cycle_date") @db.Date
  status              SettlementCycleStatus @default(PENDING)
  transactionCount    Int                   @default(0) @map("transaction_count")
  grossAmount         Decimal               @default(0) @map("gross_amount") @db.Decimal(18, 2)
  mdrAmount           Decimal               @default(0) @map("mdr_amount") @db.Decimal(18, 2)
  netAmount           Decimal               @default(0) @map("net_amount") @db.Decimal(18, 2)
  settlementAccountId String?               @map("settlement_account_id") @db.Uuid
  cbsPostingRef       String?               @map("cbs_posting_ref") @db.VarChar(100)
  sweptAt             DateTime?             @map("swept_at") @db.Timestamptz(6)
  postedAt            DateTime?             @map("posted_at") @db.Timestamptz(6)
  failureReason       String?               @map("failure_reason") @db.Text
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant  @relation(fields: [merchantId], references: [id])
  payments Payment[]

  @@unique([merchantId, cycleDate])
  @@index([merchantId, status])
  @@map("settlement_cycles")
}

/// Reconciliation exception queue (Scope §recon screens) — items where our
/// ledger and the TIPS settlement report for a cycle date don't agree.
/// Only unmatched/duplicate items ever land here; a clean match writes
/// nothing (per the design prototype's "only exceptions queued for a
/// human" framing).
model ReconciliationException {
  id              String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String                        @map("merchant_id") @db.Uuid
  cycleDate       DateTime                      @map("cycle_date") @db.Date
  type            ReconciliationExceptionType
  tipsEndToEndId  String?                       @map("tips_end_to_end_id") @db.VarChar(100)
  amount          Decimal?                      @db.Decimal(18, 2)
  status          ReconciliationExceptionStatus @default(OPEN)
  resolutionNotes String?                       @map("resolution_notes") @db.Text
  resolvedBy      String?                       @map("resolved_by") @db.Uuid
  resolvedAt      DateTime?                     @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId, status])
  @@index([cycleDate])
  @@map("reconciliation_exceptions")
}

enum DisputeReason {
  DUPLICATE_PAYMENT
  GOODS_NOT_RECEIVED
  INCORRECT_AMOUNT
  UNRECOGNIZED_TRANSACTION
  OTHER

  @@map("dispute_reason")
}

enum DisputeRaisedBy {
  MERCHANT
  PAYER
  LFB_OPS

  @@map("dispute_raised_by")
}

/// Investigation -> (EvidenceRequested) -> RefundPendingChecker (a real
/// ApprovalTask, entityType DISPUTE_REFUND) -> ResolvedRefunded /
/// ResolvedNoRefund, or Rejected if the checker declines the refund.
enum DisputeStage {
  INVESTIGATION
  EVIDENCE_REQUESTED
  REFUND_PENDING_CHECKER
  RESOLVED_REFUNDED
  RESOLVED_NO_REFUND
  REJECTED

  @@map("dispute_stage")
}

/// Handoff §disputes/§disputedet. Always tied to a real Payment — a
/// dispute over "money that moved through TIPS" is the only kind this
/// system tracks; there is no free-floating dispute with no transaction
/// behind it.
model Dispute {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acquirerId      String          @map("acquirer_id") @db.Uuid
  caseNo          String          @unique @map("case_no") @db.VarChar(20)
  merchantId      String          @map("merchant_id") @db.Uuid
  paymentId       String          @map("payment_id") @db.Uuid
  raisedBy        DisputeRaisedBy @map("raised_by")
  reason          DisputeReason
  description     String          @db.Text
  disputedAmount  Decimal         @map("disputed_amount") @db.Decimal(14, 2)
  currency        String          @default("TZS") @db.Char(3)
  stage           DisputeStage    @default(INVESTIGATION)
  slaHours        Int             @default(72) @map("sla_hours")
  resolutionNotes String?         @map("resolution_notes") @db.Text
  resolvedAt      DateTime?       @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String          @map("created_by") @db.Uuid

  acquirer Acquirer          @relation(fields: [acquirerId], references: [id])
  merchant Merchant          @relation(fields: [merchantId], references: [id])
  payment  Payment           @relation(fields: [paymentId], references: [id])
  evidence DisputeEvidence[]

  @@index([merchantId, stage])
  @@index([acquirerId, stage])
  @@map("disputes")
}

model DisputeEvidence {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disputeId  String   @map("dispute_id") @db.Uuid
  fileName   String   @map("file_name") @db.VarChar(255)
  s3Bucket   String   @map("s3_bucket") @db.VarChar(100)
  s3Key      String   @map("s3_key") @db.Text
  mimeType   String?  @map("mime_type") @db.VarChar(100)
  fileSize   Int?     @map("file_size")
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  uploadedBy String   @map("uploaded_by") @db.Uuid

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("dispute_evidence")
}

enum PolicyEffect {
  ALLOW
  DENY

  @@map("policy_effect")
}

model PolicyOverride {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acquirerId     String       @map("acquirer_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  permissionCode String       @map("permission_code") @db.VarChar(100)
  effect         PolicyEffect
  scopeType      String?      @map("scope_type") @db.VarChar(20)
  scopeId        String?      @map("scope_id") @db.Uuid
  reason         String?      @db.Text
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedBy      String?      @map("revoked_by") @db.Uuid

  acquirer Acquirer @relation(fields: [acquirerId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, permissionCode])
  @@index([acquirerId])
  @@map("policy_overrides")
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(100)
  entityType    String   @map("entity_type") @db.VarChar(100)
  entityId      String?  @map("entity_id") @db.Uuid
  metadata      Json     @default("{}")
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.Text
  correlationId String?  @map("correlation_id") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
