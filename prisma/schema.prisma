/// Brief §4.3.3: per-tier transaction limits, configurable (via
/// PATCH /transaction-limits/:tier) rather than hard-coded. Seeded with
/// conservative placeholder figures — the real TZS amounts are explicitly
/// not yet set (open question: LFB Risk/Compliance owns this number, not
/// engineering) and are expected to be a config change, not a code change,
/// once confirmed.
/// Brief §4.3 / handoff §cfgfees: "MDR and transaction fees are configured
/// per merchant category, per segment, or as an individual merchant
/// override in system configuration." Scope + scopeKey together select
/// which merchants a schedule applies to; resolution order (most specific
/// wins) is MERCHANT -> MCC -> DEFAULT, implemented in
/// FeeScheduleService.resolveForMerchant, not here.
enum FeeScheduleScope {
  DEFAULT
  MCC
  MERCHANT

  @@map("fee_schedule_scope")
}

enum FeeScheduleStatus {
  DRAFT
  ACTIVE
  SUPERSEDED

  @@map("fee_schedule_status")
}

enum FeeChargeType {
  MDR
  SETTLEMENT_TRANSFER
  QR_POSTER_REPRINT
  DISPUTE_INVESTIGATION

  @@map("fee_charge_type")
}

enum FeeChargeBasis {
  PERCENT_OF_TRANSACTION
  FLAT_PER_SWEEP
  FLAT_PER_ASSET
  FLAT_PER_CASE

  @@map("fee_charge_basis")
}

/// One version of a fee schedule for one scope. `version` is a single
/// monotonic counter shared across every schedule (not per-scope) purely
/// so the applicant-facing label ("SCHEDULE v4") means the same thing
/// everywhere — it is not used for resolution, `status` is. Activating a
/// new schedule for a scope+scopeKey that already has an ACTIVE row
/// supersedes the old one (status -> SUPERSEDED) rather than deleting it,
/// since past settlements reference the schedule version in force at
/// transaction time (handoff §ob7).
model FeeSchedule {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version       Int
  scope         FeeScheduleScope
  /// MCC code for scope=MCC, merchantId (as text) for scope=MERCHANT, null for DEFAULT.
  scopeKey      String?           @map("scope_key") @db.VarChar(50)
  status        FeeScheduleStatus @default(DRAFT)
  effectiveFrom DateTime?         @map("effective_from") @db.Timestamptz(6)
  supersededAt  DateTime?         @map("superseded_at") @db.Timestamptz(6)
  createdBy     String            @map("created_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedBy    String?           @map("approved_by") @db.Uuid
  approvedAt    DateTime?         @map("approved_at") @db.Timestamptz(6)

  charges     FeeScheduleCharge[]
  acceptances FeeScheduleAcceptance[]

  @@unique([scope, scopeKey, version])
  @@index([scope, scopeKey, status])
  @@map("fee_schedules")
}

model FeeScheduleCharge {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId String         @map("schedule_id") @db.Uuid
  chargeType FeeChargeType  @map("charge_type")
  basis      FeeChargeBasis
  /// Rate as a fraction (0.0085 = 0.85%) — only set for PERCENT_OF_TRANSACTION.
  rate       Decimal?       @db.Decimal(6, 4)
  /// Flat TZS amount — only set for the FLAT_PER_* bases.
  flatAmount Decimal?       @map("flat_amount") @db.Decimal(12, 2)
  /// Optional ceiling on the computed charge (percent-based charges only).
  capAmount  Decimal?       @map("cap_amount") @db.Decimal(12, 2)

  schedule FeeSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@map("fee_schedule_charges")
}

/// Handoff §ob7: the applicant's acknowledgement that they've seen and
/// accepted a specific schedule version, shown back to the checker at
/// review. One row per (application, schedule) — re-verifying after a
/// TIN/account correction does not require re-accepting fees, but
/// accepting a *different* schedule version does.
model FeeScheduleAcceptance {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  scheduleId    String   @map("schedule_id") @db.Uuid
  merchantId    String   @map("merchant_id") @db.Uuid
  acceptedBy    String?  @map("accepted_by") @db.Uuid
  acceptedAt    DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)

  application OnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  schedule    FeeSchedule           @relation(fields: [scheduleId], references: [id])

  @@unique([applicationId, scheduleId])
  @@index([merchantId])
  @@map("fee_schedule_acceptances")
}

