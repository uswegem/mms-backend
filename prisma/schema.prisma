// MMS — Prisma schema aligned with Database/migrations/001_initial_schema.sql

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING_INVITE

  @@map("user_status")
}

/// bcrypt -> Argon2id migration (see docs/architecture-decisions).
/// Explicit column rather than inferring from hash prefix at read time, so
/// migration-status reporting is a plain query, not string parsing.
enum PasswordAlgo {
  BCRYPT
  ARGON2ID

  @@map("password_algo")
}

enum MerchantStatus {
  DRAFT
  PENDING_REVIEW
  PENDING_APPROVAL
  REJECTED
  ACTIVE
  SUSPENDED
  DORMANT
  CLOSED

  @@map("merchant_status")
}

enum MerchantStatusAction {
  SUBMIT_FOR_REVIEW
  MOVE_TO_PENDING_APPROVAL
  APPROVE
  REJECT
  SUSPEND
  REACTIVATE
  MARK_DORMANT
  CLOSE

  @@map("merchant_status_action")
}

enum DocumentType {
  KYC_ID
  KYC_LICENSE
  KYC_TIN
  QR_ASSET
  RECEIPT
  OTHER

  @@map("document_type")
}

enum KycStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED

  @@map("kyc_status")
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  PENDING_KYC_DOCUMENTS
  PENDING_KYC_APPROVAL
  KYC_REJECTED
  PENDING_RISK_REVIEW
  RISK_REJECTED
  PENDING_BANK_VALIDATION
  BANK_VALIDATION_FAILED
  BANK_VALIDATED
  PENDING_TPS_REGISTRATION
  TPS_REGISTRATION_FAILED
  TPS_REGISTERED
  PENDING_ALIAS_QR_SETUP
  ALIAS_QR_FAILED
  ALIAS_QR_REGISTERED
  PENDING_SETTLEMENT_SETUP
  SETTLEMENT_APPROVAL_PENDING
  SETTLEMENT_REJECTED
  SETTLEMENT_APPROVED
  READY_FOR_ACTIVATION
  ACTIVE
  REJECTED
  SUSPENDED
  FAILED
  UNDER_REVIEW
  APPROVED

  @@map("onboarding_status")
}

enum DocumentVerificationStatus {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED

  @@map("document_verification_status")
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  INACTIVE

  @@map("student_status")
}

enum IntegrationType {
  TPS
  CFS
  CBS
  UPI
  QR
  SETTLEMENT

  @@map("integration_type")
}

enum IntegrationStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING

  @@map("integration_status")
}

enum RiskReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SENT_BACK

  @@map("risk_review_status")
}

enum StoreStatus {
  PENDING
  ACTIVE
  FAILED
  INACTIVE

  @@map("store_status")
}

enum SettlementApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED

  @@map("settlement_approval_status")
}

enum LegalEntityType {
  SOLE_PROPRIETOR
  COMPANY

  @@map("legal_entity_type")
}

enum ApprovalTaskStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED

  @@map("approval_task_status")
}

enum ApprovalEntityType {
  MERCHANT_ONBOARDING
  SCHOOL_ONBOARDING
  SETTLEMENT_BATCH
  FEE_RULE
  MERCHANT_LIMIT
  CONFIG_CHANGE
  MERCHANT_STATUS_CHANGE

  @@map("approval_entity_type")
}

enum AmlResult {
  PASS
  FAIL
  REVIEW

  @@map("aml_result")
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REVERSED
  DISPUTED
  REFUND_PENDING

  @@map("payment_status")
}

enum PaymentChannel {
  QR
  LIPA_NAMBA
  USSD
  API
  OTHER

  @@map("payment_channel")
}

enum SettlementCycleStatus {
  PENDING // computed, not yet swept
  SWEPT // funds moved to the settlement account
  POSTED // posted to the CBS ledger — the cycle's terminal state
  FAILED

  @@map("settlement_cycle_status")
}

enum ReconciliationExceptionType {
  UNMATCHED_IN_REPORT // present in the TIPS settlement report, not in our ledger
  UNMATCHED_IN_LEDGER // present in our ledger, not in the TIPS settlement report
  DUPLICATE_REFERENCE

  @@map("reconciliation_exception_type")
}

enum ReconciliationExceptionStatus {
  OPEN
  RESOLVED
  WRITTEN_OFF

  @@map("reconciliation_exception_status")
}

enum QrType {
  STATIC
  DYNAMIC

  @@map("qr_type")
}

enum QrStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@map("qr_status")
}

enum TipsRegistrationStatus {
  PENDING
  REGISTERED
  FAILED

  @@map("tips_registration_status")
}

model Acquirer {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String    @unique @db.VarChar(20)
  legalName           String    @map("legal_name") @db.VarChar(255)
  tradingName         String?   @map("trading_name") @db.VarChar(255)
  tipsParticipantCode String?   @map("tips_participant_code") @db.VarChar(3)
  tipsAcquirerId5     String?   @map("tips_acquirer_id_5") @db.Char(5)
  status              String    @default("ACTIVE") @db.VarChar(20)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?   @map("deleted_by") @db.Uuid

  users                User[]
  merchants            Merchant[]
  payments             Payment[]
  roles                Role[]
  onboardingApps       OnboardingApplication[]
  approvalPolicies     ApprovalPolicy[]
  approvalTasks        ApprovalTask[]
  policyOverrides      PolicyOverride[]

  @@map("acquirers")
}

model User {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acquirerId  String     @map("acquirer_id") @db.Uuid
  merchantId  String?    @map("merchant_id") @db.Uuid
  email       String     @db.Citext
  fullName    String     @map("full_name") @db.VarChar(255)
  status      UserStatus @default(PENDING_INVITE)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?    @map("created_by") @db.Uuid
  updatedBy   String?    @map("updated_by") @db.Uuid
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?    @map("deleted_by") @db.Uuid

  acquirer            Acquirer             @relation(fields: [acquirerId], references: [id])
  merchant            Merchant?            @relation(fields: [merchantId], references: [id])
  profile             UserProfile?
  authCredential      AuthCredential?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  userRoles           UserRole[]
  invitationsSent     UserInvitation[] @relation("InvitedBy")
  policyOverrides     PolicyOverride[]

  @@unique([acquirerId, email])
  @@index([acquirerId], map: "idx_users_acquirer")
  @@map("users")
}

model UserProfile {
  userId     String   @id @map("user_id") @db.Uuid
  phone      String?  @db.VarChar(20)
  department String?  @db.VarChar(100)
  locale     String   @default("en") @db.VarChar(10)
  timezone   String   @default("Africa/Dar_es_Salaam") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserInvitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acquirerId String    @map("acquirer_id") @db.Uuid
  email      String    @db.Citext
  roleId     String    @map("role_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  invitedBy  String?   @map("invited_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  inviter User? @relation("InvitedBy", fields: [invitedBy], references: [id])
  role    Role  @relation(fields: [roleId], references: [id])

  @@index([email])
  @@index([tokenHash])
  @@map("user_invitations")
}

model AuthCredential {
  userId            String       @id @map("user_id") @db.Uuid
  passwordHash      String       @map("password_hash") @db.VarChar(255)
  /// Defaults to BCRYPT to correctly reflect every row that existed before
  /// the Argon2id migration shipped; every write path that produces a fresh
  /// hash (login rehash, reset, new-user creation) sets ARGON2ID explicitly
  /// — the default is never relied on for "this is a new hash" semantics.
  passwordAlgo      PasswordAlgo @default(BCRYPT) @map("password_algo")
  /// Set when a BCRYPT hash is lazily rehashed to Argon2id on login, or when
  /// a forced reset completes. Null means still on the original algorithm.
  passwordMigratedAt DateTime?   @map("password_migrated_at") @db.Timestamptz(6)
  /// When true, valid credentials are not enough to obtain a session — the
  /// login flow routes to forced password reset instead. Set at Argon2id
  /// migration cutover for privileged accounts, and by the 90-day backstop
  /// job for any account still on BCRYPT past the deadline.
  mustResetPassword Boolean      @default(false) @map("must_reset_password")
  /// Set the first time the 90-day-backstop warning email goes out, so the
  /// daily job sends it once per user instead of every run during the
  /// warning window.
  passwordResetWarnedAt DateTime? @map("password_reset_warned_at") @db.Timestamptz(6)
  mfaSecretEnc      Bytes?    @map("mfa_secret_enc")
  mfaEnabled        Boolean   @default(false) @map("mfa_enabled")
  failedAttempts    Int       @default(0) @map("failed_attempts") @db.SmallInt
  lockoutUntil      DateTime? @map("lockout_until") @db.Timestamptz(6)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdIp  String?   @map("created_ip")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user")
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model LoginAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.Citext
  success   Boolean
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("login_attempts")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acquirerId String?   @map("acquirer_id") @db.Uuid
  code       String    @db.VarChar(50)
  name       String    @db.VarChar(100)
  isSystem   Boolean   @default(false) @map("is_system")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy  String?   @map("deleted_by") @db.Uuid

  acquirer    Acquirer?        @relation(fields: [acquirerId], references: [id])
  permissions RolePermission[]
  userRoles     UserRole[]
  invitations   UserInvitation[]

  @@unique([acquirerId, code])
  @@map("roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  scopeType String   @default("ACQUIRER") @map("scope_type") @db.VarChar(20)
  scopeId   String?  @map("scope_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, scopeType, scopeId])
  @@map("user_roles")
}

model Merchant {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acquirerId  String         @map("acquirer_id") @db.Uuid
  merchantCode String?       @unique @map("merchant_code") @db.VarChar(30)
  legalName   String         @map("legal_name") @db.VarChar(255)
  tradingName String         @map("trading_name") @db.VarChar(100)
  displayName String?        @map("display_name") @db.VarChar(100)
  status      MerchantStatus @default(DRAFT)
  mcc         String         @default("0000") @db.Char(4)
  businessCategory String?   @map("business_category") @db.VarChar(100)
  taxId       String?        @map("tax_id") @db.VarChar(50)
  vrn         String?        @db.VarChar(20)
  licenseNumber String?      @map("license_number") @db.VarChar(50)
  pan         String?        @db.VarChar(20)
  gstin       String?        @db.VarChar(20)
  contactPerson String?      @map("contact_person") @db.VarChar(255)
  relationshipManager String? @map("relationship_manager") @db.VarChar(100)
  branch      String?        @db.VarChar(100)
  sourceChannel String?      @map("source_channel") @db.VarChar(50)
  isSchool    Boolean        @default(false) @map("is_school")
  onboardedAt DateTime?      @map("onboarded_at") @db.Timestamptz(6)
  activatedAt DateTime?      @map("activated_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?        @map("created_by") @db.Uuid
  updatedBy   String?        @map("updated_by") @db.Uuid
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?        @map("deleted_by") @db.Uuid

  pendingStatusAction      MerchantStatusAction? @map("pending_status_action")
  pendingStatusReason      String?               @map("pending_status_reason") @db.VarChar(255)
  pendingStatusRequestedBy String?               @map("pending_status_requested_by") @db.Uuid
  pendingStatusRequestedAt DateTime?             @map("pending_status_requested_at") @db.Timestamptz(6)

  acquirer  Acquirer           @relation(fields: [acquirerId], references: [id])
  users     User[]
  payments  Payment[]
  profile              MerchantProfile?
  kyc                  MerchantKyc?
  documents            MerchantDocument[]
  reviews              MerchantKycReview[]
  onboardingApps       OnboardingApplication[]
  settlementAccounts   SettlementAccount[]
  cbsVerifications     CbsAccountVerification[]
  school               School?
  statusHistory        MerchantStatusHistory[]
  merchantAlias        MerchantAlias?
  schoolSequence       SchoolSequence?
  students             Student[]
  studentAliases       StudentAlias[]
  qrCodes              QrCode[]
  tipsRegistration     TipsRegistration?
  riskReviews          MerchantRiskReview[]
  integrations         MerchantIntegration[]
  stores               MerchantStore[]
  settlementConfig     MerchantSettlementConfig?
  onboardingAuditLogs  OnboardingAuditLog[]
  settlementCycles         SettlementCycle[]
  reconciliationExceptions ReconciliationException[]
  studentRosterUploads     StudentRosterUpload[]

  @@index([acquirerId, status], map: "idx_merchants_acquirer_status")
  @@index([tradingName], map: "idx_merchants_trading_name")
  @@index([taxId], map: "idx_merchants_tax_id")
  @@index([vrn], map: "idx_merchants_vrn")
  @@map("merchants")
}

model StatusTransition {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromStatus         MerchantStatus       @map("from_status")
  toStatus           MerchantStatus       @map("to_status")
  action             MerchantStatusAction
  requiredPermission String               @map("required_permission") @db.VarChar(100)
  description        String?              @db.VarChar(255)
  isActive           Boolean              @default(true) @map("is_active")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([fromStatus, toStatus, action])
  @@map("status_transitions")
}

model MerchantStatusHistory {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String               @map("merchant_id") @db.Uuid
  fromStatus MerchantStatus       @map("from_status")
  toStatus   MerchantStatus       @map("to_status")
  action     MerchantStatusAction @map("action")
  actorId    String               @map("actor_id") @db.Uuid
  reason     String?              @db.VarChar(100)
  notes      String?              @db.Text
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt(sort: Desc)])
  @@map("merchant_status_history")
}

model MerchantProfile {
  merchantId    String   @id @map("merchant_id") @db.Uuid
  addressLine1  String?  @map("address_line1") @db.VarChar(255)
  addressLine2  String?  @map("address_line2") @db.VarChar(255)
  region        String?  @db.VarChar(100)
  district      String?  @db.VarChar(100)
  ward          String?  @db.VarChar(100)
  city          String?  @db.VarChar(100)
  postalCode    String   @map("postal_code") @db.Char(5)
  countryCode   String   @default("TZ") @map("country_code") @db.Char(2)
  contactPhone  String?  @map("contact_phone") @db.VarChar(20)
  contactEmail  String?  @map("contact_email") @db.Citext
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_profiles")
}

// ─── Reference data (Milestone B) ──────────────────────────────────────────
// Authoritative Region → District → Ward → postcode hierarchy and bank/SWIFT
// catalog, seeded from a real public Tanzania administrative-locations
// dataset. Backs server-side validation of MerchantProfile's region/
// district/ward/postalCode fields and SettlementAccount.bankCode — both of
// which were previously free text with no validation at all — and is the
// data TANQR tag 60/61 (city/postal code) ultimately depends on being real.
model ReferenceRegion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  districts ReferenceDistrict[]

  @@map("reference_regions")
}

model ReferenceDistrict {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  regionId String @map("region_id") @db.Uuid
  name     String @db.VarChar(50)

  region ReferenceRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  wards  ReferenceWard[]

  @@unique([regionId, name])
  @@map("reference_districts")
}

model ReferenceWard {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  districtId String @map("district_id") @db.Uuid
  name       String @db.VarChar(50)
  // VarChar(6), not Char(5) like MerchantProfile.postalCode: the source
  // dataset has exactly one ward (Morogoro/Malinyi/Kilosampepo) with a
  // 6-digit postcode ("678010"). Stored faithfully rather than truncated —
  // ReferenceDataService.validateLocation() flags it explicitly as a known
  // data anomaly if a merchant is ever registered against that ward, rather
  // than let it fail as an opaque DB error against the narrower column.
  postcode String @db.VarChar(6)

  district ReferenceDistrict @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([districtId, name])
  @@index([postcode])
  @@map("reference_wards")
}

model ReferenceBank {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  swiftCode String   @unique @map("swift_code") @db.VarChar(11)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("reference_banks")
}

model MerchantKyc {
  merchantId  String    @id @map("merchant_id") @db.Uuid
  status      KycStatus @default(PENDING)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

