model QrCode {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId     String    @map("merchant_id") @db.Uuid
  studentId      String?   @map("student_id") @db.Uuid
  storeId        String?   @map("store_id") @db.Uuid
  terminalId     String?   @map("terminal_id") @db.Uuid
  qrType         QrType    @map("qr_type")
  status         QrStatus  @default(ACTIVE)
  poiMethod      String    @map("poi_method") @db.Char(2)
  currentVersion Int       @default(1) @map("current_version")
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid

  merchant        Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  student         Student?           @relation(fields: [studentId], references: [id])
  payloadVersions QrPayloadVersion[]
  renderAssets    QrRenderAsset[]
  studentAliases  StudentAlias[]

  @@index([merchantId, status])
  @@index([merchantId, qrType, status, storeId, terminalId])
  @@map("qr_codes")
}

model QrPayloadVersion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  qrId            String   @map("qr_id") @db.Uuid
  version         Int
  tlvPayload      String   @map("tlv_payload") @db.Text
  crcValue        String   @map("crc_value") @db.Char(4)
  tag26Alias      String?  @map("tag_26_02_alias") @db.VarChar(8)
  tag62InternalId String?  @map("tag_62_05_internal_id") @db.VarChar(8)
