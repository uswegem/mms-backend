  currency      String   @default("TZS") @db.Char(3)
  reason        String   @db.VarChar(500)
  approvedBy    String?  @map("approved_by") @db.Uuid
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  exceptionCase ReconciliationExceptionCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  merchant      Merchant?                   @relation(fields: [merchantId], references: [id], onDelete: SetNull)

